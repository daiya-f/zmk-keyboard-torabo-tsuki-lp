/*
 * 4-direction switch module on the BMP Boost Extender (Mini) FFC.
 * The main KDK-Link port stays free for the trackpad / trackball.
 *
 * Extender FFC : 2=P0.17  3=P0.21  4=P0.29  5=P0.31  6=P0.24(POW)
 * (same pin order as the main KDK-Link: 2=P0.18 3=P0.16 4=P0.19 5=P0.20)
 */
#include "../kscan-4-direction-switch/kscan-4-direction-switch-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout_l_4_direction;
        zmk,kscan = &kscan2;
    };

    kscan1: kscan1 {
        compatible = "zmk,kscan-4-direction-switch";

        up-gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        down-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        left-gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                     <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        right-gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        push-gpios = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        wakeup-source;
    };

    kscan2: kscan2 {
        compatible = "zmk,kscan-composite";
        rows = <6>;
        columns = <7>;

        matrix {
            kscan = <&kscan0>;
#if defined(TORABO_TSUKI_LP_RIGHT)
            col-offset = <7>;
#endif
        };

        4-direction {
            kscan = <&kscan1>;
            row-offset = <5>;
        };
    };
};

/* FFC pin 6 (POW) = module VCC per KDK-Link */
&gpio0 {
    kdk_ext_pwr_hog {
        gpio-hog;
        gpios = <24 GPIO_ACTIVE_HIGH>;
        output-high;
    };
};
